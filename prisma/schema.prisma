/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id               String             @id @db.Uuid
  full_name        String             @default("")
  phone            String?
  locale           app_locale         @default(fr)
  role             user_role          @default(student)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  coupons          coupons[]
  courses          courses[]
  entitlements     entitlements[]
  payment_settings payment_settings[]
  users            users              @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([role], where: raw("(role <> 'student'::user_role)"))
  @@schema("public")
}

enum app_locale {
  fr
  en

  @@schema("public")
}

enum catalog_status {
  draft
  published
  archived

  @@schema("public")
}

enum course_format {
  presentiel
  visio
  hybride

  @@schema("public")
}

enum course_level {
  all
  beginner
  intermediate
  advanced

  @@schema("public")
}

enum course_status {
  draft
  published
  archived

  @@schema("public")
}

enum cursus_kind {
  module
  approfondi

  @@schema("public")
}

enum delivery_mode {
  presentiel
  online

  @@schema("public")
}

enum entitlement_scope {
  course
  cursus
  site

  @@schema("public")
}

enum lesson_type {
