generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model users {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?           @unique
  raw_user_meta_data Json              @default("{}")
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  enrollments        enrollments[]
  entitlements       entitlements?
  lesson_progress    lesson_progress[]
  orders             orders[]
  profiles           profiles?

  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model coupons {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String    @unique
  percent_off      Int?
  amount_off_cents Int?
  currency         String    @default("EUR")
  max_redemptions  Int?
  redeemed_count   Int       @default(0)
  expires_at       DateTime? @db.Timestamptz(6)
  is_office        Boolean   @default(false)
  batch            String    @default("")
  note             String    @default("")
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  profiles         profiles? @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  orders           orders[]

  @@index([batch], where: raw("(batch <> ''::text)"))
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model courses {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String           @unique
  title          String
  subtitle       String           @default("")
  description    String           @default("")
  title_ar       String           @default("")
  cover_url      String?
  tone           String           @default("emerald")
  category       String           @default("fiqh")
  level          course_level     @default(all)
  format         course_format    @default(hybride)
  language       String           @default("fr")
  instructor_id  String?          @db.Uuid
  status         course_status    @default(draft)
  published_at   DateTime?        @db.Timestamptz(6)
  display_order  Int              @default(0)
  schedule       String           @default("")
  duration_weeks Int              @default(0)
  objectives     Json             @default("[]")
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  profiles       profiles?        @relation(fields: [instructor_id], references: [id], onUpdate: NoAction)
  cursus_courses cursus_courses[]
  enrollments    enrollments[]
  entitlements   entitlements[]
  modules        modules[]
  order_items    order_items[]
  products       products[]

  @@index([category], where: raw("(status = 'published'::course_status)"))
  @@index([display_order, published_at(sort: Desc)], map: "courses_published_idx", where: raw("(status = 'published'::course_status)"))
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cursus {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String           @unique
  kind           cursus_kind
  title          String
  subtitle       String           @default("")
  description    String           @default("")
  year_count     Int              @default(1)
  status         catalog_status   @default(draft)
  display_order  Int              @default(0)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  cursus_courses cursus_courses[]
  entitlements   entitlements[]
  order_items    order_items[]
  products       products[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cursus_courses {
  cursus_id  String        @db.Uuid
  course_id  String        @db.Uuid
  delivery   delivery_mode
  year_index Int           @default(1)
  position   Int           @default(0)
  courses    courses       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cursus     cursus        @relation(fields: [cursus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([cursus_id, course_id, delivery, year_index])
  @@index([course_id], map: "cursus_courses_course_idx")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model enrollments {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  course_id        String   @db.Uuid
  enrolled_at      DateTime @default(now()) @db.Timestamptz(6)
  last_accessed_at DateTime @default(now()) @db.Timestamptz(6)
  courses          courses  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([user_id, last_accessed_at(sort: Desc)], map: "enrollments_user_idx")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model entitlements {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String            @unique(map: "entitlements_one_active_site", where: raw("((status = 'active'::membership_status) AND (scope = 'site'::entitlement_scope))")) @db.Uuid
  scope           entitlement_scope
  course_id       String?           @db.Uuid
  cursus_id       String?           @db.Uuid
  year_index      Int               @default(1)
  delivery        delivery_mode     @default(online)
  status          membership_status @default(active)
  starts_at       DateTime          @default(now()) @db.Timestamptz(6)
  expires_at      DateTime          @db.Timestamptz(6)
  source_order_id String?           @db.Uuid
  granted_by      String?           @db.Uuid
  note            String            @default("")
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  courses         courses?          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cursus          cursus?           @relation(fields: [cursus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles        profiles?         @relation(fields: [granted_by], references: [id], onUpdate: NoAction)
  orders          orders?           @relation(fields: [source_order_id], references: [id], onUpdate: NoAction)
  users           users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id, delivery], map: "entitlements_one_active_course", where: raw("((status = 'active'::membership_status) AND (scope = 'course'::entitlement_scope))"))
  @@unique([user_id, cursus_id, year_index, delivery], map: "entitlements_one_active_cursus", where: raw("((status = 'active'::membership_status) AND (scope = 'cursus'::entitlement_scope))"))
  @@index([expires_at], map: "entitlements_expiry_idx", where: raw("(status = 'active'::membership_status)"))
  @@index([user_id], map: "entitlements_user_idx", where: raw("(status = 'active'::membership_status)"))
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lesson_content {
  lesson_id      String         @id @db.Uuid
  content        String         @default("")
  video_provider video_provider @default(none)
  video_id       String?
  attachments    Json           @default("[]")
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  lessons        lessons        @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lesson_progress {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String          @db.Uuid
  lesson_id       String          @db.Uuid
  status          progress_status @default(not_started)
  seconds_watched Int             @default(0)
  completed_at    DateTime?       @db.Timestamptz(6)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  lessons         lessons         @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, lesson_id])
  @@index([user_id, lesson_id], map: "lesson_progress_user_idx")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lessons {
