/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           product_kind
  course_id      String?        @db.Uuid
  cursus_id      String?        @db.Uuid
  year_index     Int            @default(1)
  delivery       delivery_mode
  price_cents    Int
  currency       String         @default("EUR")
  duration_days  Int            @default(365)
  status         catalog_status @default(draft)
  display_order  Int            @default(0)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  time_slot      String         @default("")
  schedule_label String         @default("")
  hours_per_year Int?
  hours_per_week Int?
  language       String         @default("fr")
  order_items    order_items[]
  pack_items     pack_items[]
  courses        courses?       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cursus         cursus?        @relation(fields: [cursus_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([cursus_id, year_index, delivery, time_slot, language], map: "products_one_per_cursus_year_slot", where: raw("((kind = 'cursus'::product_kind) AND (status <> 'archived'::catalog_status))"))
  @@unique([course_id, delivery, time_slot, language], map: "products_one_per_module_slot", where: raw("((kind = 'module'::product_kind) AND (status <> 'archived'::catalog_status))"))
  @@index([delivery, display_order], map: "products_published_idx", where: raw("(status = 'published'::catalog_status)"))
  @@index([delivery, time_slot, display_order], map: "products_slot_idx", where: raw("(status = 'published'::catalog_status)"))
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
