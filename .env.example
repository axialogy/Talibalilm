# ---------------------------------------------------------------------------
# Supabase
#
# Create the project in an EU region — the school operates in France and GDPR
# requires student data to stay in the EU (spec §8).
# Project settings → API gives you all three values.
# ---------------------------------------------------------------------------

# Safe in the browser bundle. What the anon key can actually do is decided by
# the RLS policies in supabase/migrations/, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. Never prefix it NEXT_PUBLIC_, never
# import it from a Client Component. Used for the Stripe webhook grant, the
# nightly expiry job and minting LiveKit tokens — all after an authorisation
# check has already passed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
#
# The absolute origin, used to build auth redirect URLs. Supabase will only
# redirect to URLs listed in Authentication → URL Configuration, so this value
# and that allow-list have to agree. On Vercel previews, VERCEL_URL is used
# automatically when this is unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Scheduled housekeeping.
#
# Vercel Cron calls /api/cron/sweep with `Authorization: Bearer <CRON_SECRET>`.
# It cancels checkouts nobody came back to — handing their coupon and pack
# redemption back — and marks expired entitlements expired.
#
# REQUIRED. Without it the endpoint refuses every call, because an open
# endpoint that cancels orders is worse than a job that does not run. Generate
# with: openssl rand -base64 32
# ---------------------------------------------------------------------------
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Prisma.
#
# The Supabase client talks HTTP and needs none of this; Prisma needs a real
# Postgres connection. Both point at the same database.
#
# DATABASE_URL must be the TRANSACTION pooler (port 6543) on Vercel — a
# serverless function cannot hold a connection open between invocations, and
# the direct URL exhausts the database's slots under any real traffic.
#
# DIRECT_URL is the unpooled one, used by migrations and `prisma db pull`: the
# transaction pooler holds no session state, so DDL fails through it.
#
# Both are in Supabase under Settings -> Database -> Connection string.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# PayPal.
#
# Optional. Leave these unset and the school enters its credentials in
# Admin -> Payments instead, which is the easier path but stores a live API
# secret in a database row. Set here, they win over that row — a key in
# Vercel's encrypted store is the safer place for it.
#
# PAYPAL_ENVIRONMENT is 'sandbox' or 'live'. PAYPAL_WEBHOOK_ID comes from the
# webhook you create in the PayPal developer dashboard, pointed at
# https://your-domain.com/api/paypal/webhook and subscribed to
# PAYMENT.CAPTURE.COMPLETED. Without it, webhooks cannot be verified and are
# refused — which is the correct failure, not a bug.
# ---------------------------------------------------------------------------
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_CURRENCY=EUR

# ---------------------------------------------------------------------------
# Optional side effects. Each one unset is a logged no-op, never a crash:
# a student still gets access without a receipt, and a missing error sink
# does not take down a page.
#
# LiveKit and Bunny Stream were placeholders from an earlier plan and have
# been removed — no code reads them. The classroom runs on Jitsi (below) and
# recordings are saved to the teacher's own computer, so neither service is
# needed. Delete them from Vercel if you added them.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Live classroom
#
# Jitsi hosts the room. Optional: unset, it falls back to the public
# `meet.jit.si`, which costs nothing and needs no account — good enough to run
# real classes while the school decides. Point it at 8x8's hosted Jitsi or their
# own server later and nothing else changes.
#
# A bare hostname, no scheme and no path.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ---------------------------------------------------------------------------
# Cloudflare R2 — slide storage
#
# Holds the images a teacher shows during a live class, and nothing else.
# Recordings do NOT come here: a recording is made by the teacher's browser and
# saved to their own computer, which is what keeps the feature free.
#
# All four are ordinary secrets. Set them as "Secret" in Vercel, never
# "Config", and never with a NEXT_PUBLIC_ prefix — the module that reads them
# is marked `server-only`, so a prefixed copy would be the one way they could
# reach a browser.
#
# Unset, slide upload says storage is not configured and everything else about
# the live class — the room, the video, the recording — carries on.
#
# Where each value comes from, in the Cloudflare dashboard:
#   R2_ACCOUNT_ID          R2 → Overview, the "Account ID" on the right
#   R2_BUCKET              the bucket's name, e.g. talibalim-slides
#   R2_ACCESS_KEY_ID       R2 → Manage API tokens → Create token
#   R2_SECRET_ACCESS_KEY   shown once, on that same screen
#
# The token needs "Object Read & Write" on that one bucket. Nothing more: it
# never creates buckets and never touches another.
#
# Keep the bucket PRIVATE. Do not enable a public r2.dev URL and do not put a
# custom domain in front of it — every slide is served through a signed link
# minted only after the database has confirmed the viewer holds the course.
# A public bucket would quietly bypass that.
#
# THE BUCKET ALSO NEEDS A CORS POLICY, or every upload fails.
#
# The browser PUTs each slide straight to Cloudflare rather than through a
# Vercel function, which makes it a cross-origin request — and R2 refuses one
# from an origin the bucket has not been told about. Nothing in the four
# variables above hints at this, and the browser's error says only "failed to
# fetch", so it is worth stating plainly. In the Cloudflare dashboard:
# R2 → your bucket → Settings → CORS Policy:
#
#   [
#     {
#       "AllowedOrigins": ["https://your-domain.com"],
#       "AllowedMethods": ["PUT"],
#       "AllowedHeaders": ["content-type"],
#       "MaxAgeSeconds": 3600
#     }
#   ]
#
# The origin must match NEXT_PUBLIC_SITE_URL exactly — scheme included, no
# trailing slash. PUT is the only method needed: slides are displayed with a
# plain <img>, which browsers do not apply CORS to. Vercel preview deployments
# get a fresh random origin each time and are therefore not covered.
# ---------------------------------------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ---------------------------------------------------------------------------
# Ably — the classroom's realtime channel
#
# Carries WebRTC signalling, chat, the raised hands, the whiteboard and the
# host's commands. It never carries audio, video or a shared screen: that is
# peer-to-peer between the browsers, and sending media through Ably would be
# both ruinous and pointless.
#
# THIS IS A ROOT KEY. Set it as "Secret" in Vercel and never with a
# NEXT_PUBLIC_ prefix. The browser must never see it — it asks the server for a
# token instead, and the token it receives is scoped to one room's two channels
# with only the capability that person's role has earned. `src/lib/live/ably.ts`
# is marked `server-only`, so a Client Component importing it fails the build
# rather than shipping the key.
#
# The WordPress plugin this replaces printed its root key into the HTML of
# every room. If you are reusing that key, revoke it first: it has been readable
# by every student who ever opened a class.
#
# Free tier at the time of writing: 6M messages and 200 concurrent connections
# a month, which is far more than a school of this size sends. A class of 50
# spends its messages on WebRTC negotiation at the start and then very little.
# ---------------------------------------------------------------------------
# ABLY_API_KEY=
