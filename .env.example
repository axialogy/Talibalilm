# Supabase — optional.
#
# Leave these unset and the app runs entirely from localStorage: every feature
# works, the data just lives in one browser. Set them and the storefront and
# dashboard share a real backend.
#
# Both values are safe to expose in the client bundle. The anon key is meant to
# be public; what it can actually do is decided by the RLS policies in
# supabase_schema.sql — read the SECURITY block in that file before going live.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dashboard sign-in.
#
# Required in production builds — without both, the login form refuses every
# attempt rather than falling back to a default password. Dev builds keep a
# fallback so `npm run dev` works with no setup.
#
# IMPORTANT: this is a client-side gate, not authentication. These values are
# compiled into the JavaScript bundle and served to every visitor, so treat
# them as obscurity, not security. Keeping them here means the password is not
# committed to the repository and can be rotated from the hosting dashboard.
# Replacing this with Supabase Auth is the real fix — see supabase_schema.sql.

VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
