# ---------------------------------------------------------------------------
# Supabase
#
# Create the project in an EU region — the school operates in France and GDPR
# requires student data to stay in the EU (spec §8).
# Project settings → API gives you all three values.
# ---------------------------------------------------------------------------

# Safe in the browser bundle. What the anon key can actually do is decided by
# the RLS policies in supabase/migrations/, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. Never prefix it NEXT_PUBLIC_, never
# import it from a Client Component. Used for the Stripe webhook grant, the
# nightly expiry job and minting LiveKit tokens — all after an authorisation
# check has already passed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
#
# The absolute origin, used to build auth redirect URLs. Supabase will only
# redirect to URLs listed in Authentication → URL Configuration, so this value
# and that allow-list have to agree. On Vercel previews, VERCEL_URL is used
# automatically when this is unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Scheduled housekeeping.
#
# Vercel Cron calls /api/cron/sweep with `Authorization: Bearer <CRON_SECRET>`.
# It cancels checkouts nobody came back to — handing their coupon and pack
# redemption back — and marks expired entitlements expired.
#
# REQUIRED. Without it the endpoint refuses every call, because an open
# endpoint that cancels orders is worse than a job that does not run. Generate
# with: openssl rand -base64 32
# ---------------------------------------------------------------------------
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Prisma.
#
# The Supabase client talks HTTP and needs none of this; Prisma needs a real
# Postgres connection. Both point at the same database.
#
# DATABASE_URL must be the TRANSACTION pooler (port 6543) on Vercel — a
# serverless function cannot hold a connection open between invocations, and
# the direct URL exhausts the database's slots under any real traffic.
#
# DIRECT_URL is the unpooled one, used by migrations and `prisma db pull`: the
# transaction pooler holds no session state, so DDL fails through it.
#
# Both are in Supabase under Settings -> Database -> Connection string.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# PayPal.
#
# Optional. Leave these unset and the school enters its credentials in
# Admin -> Payments instead, which is the easier path but stores a live API
# secret in a database row. Set here, they win over that row — a key in
# Vercel's encrypted store is the safer place for it.
#
# PAYPAL_ENVIRONMENT is 'sandbox' or 'live'. PAYPAL_WEBHOOK_ID comes from the
# webhook you create in the PayPal developer dashboard, pointed at
# https://your-domain.com/api/paypal/webhook and subscribed to
# PAYMENT.CAPTURE.COMPLETED. Without it, webhooks cannot be verified and are
# refused — which is the correct failure, not a bug.
# ---------------------------------------------------------------------------
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_CURRENCY=EUR

# ---------------------------------------------------------------------------
# Phases 4–6 — not read yet, listed so the deployment is set up once.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_TOKEN_AUTH_KEY=
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Live classroom
#
# Jitsi hosts the room. Optional: unset, it falls back to the public
# `meet.jit.si`, which costs nothing and needs no account — good enough to run
# real classes while the school decides. Point it at 8x8's hosted Jitsi or their
# own server later and nothing else changes.
#
# A bare hostname, no scheme and no path.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
