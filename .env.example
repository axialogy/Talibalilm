# ---------------------------------------------------------------------------
# Supabase
#
# Create the project in an EU region — the school operates in France and GDPR
# requires student data to stay in the EU (spec §8).
# Project settings → API gives you all three values.
# ---------------------------------------------------------------------------

# Safe in the browser bundle. What the anon key can actually do is decided by
# the RLS policies in supabase/migrations/, not by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. Never prefix it NEXT_PUBLIC_, never
# import it from a Client Component. Used for the Stripe webhook grant, the
# nightly expiry job and minting LiveKit tokens — all after an authorisation
# check has already passed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
#
# The absolute origin, used to build auth redirect URLs. Supabase will only
# redirect to URLs listed in Authentication → URL Configuration, so this value
# and that allow-list have to agree. On Vercel previews, VERCEL_URL is used
# automatically when this is unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phases 3–5 — not read yet, listed so the deployment is set up once.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# NEXT_PUBLIC_LIVEKIT_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_TOKEN_AUTH_KEY=
# SENTRY_DSN=
